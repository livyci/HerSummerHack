DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Production (Railway) — leave unset locally
# DATABASE_URL is injected automatically by the Railway Postgres plugin
# DATABASE_URL=postgres://...
# CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app
# CORS_ORIGINS=https://your-frontend.vercel.app

# Anthropic (Claude) API key — used server-side for the /api/ai/* endpoints.
# The browser never sees this. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=
