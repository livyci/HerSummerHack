# Note: the Anthropic API key is NO LONGER a frontend variable. The AI calls now
# run server-side via the Django backend (/api/ai/*), so the key lives only in
# the backend environment as ANTHROPIC_API_KEY — see backend/.env.example.

# Scandit Data Capture SDK license key — enables real camera barcode scanning
# (BarcodeCapture, full-screen) on the Shopping page. Provided by the hackathon
# organizers; you can also generate one at https://ssl.scandit.com
# Required for the camera scanner; without it the "Scan barcode" button shows a
# clear setup error (a dev-only manual code entry is available as a fallback).
VITE_SCANDIT_LICENSE_KEY=

# Optional: only needed if pairing with the Django backend.
# Leave empty in dev — Vite proxies /api to the local Django server.
# In production (Vercel), set to your Railway backend URL, e.g.:
# VITE_API_URL=https://your-app.up.railway.app
VITE_API_URL=
